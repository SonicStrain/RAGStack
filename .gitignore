# ── Secrets / environment variables ─────────────────────────────────────────
.env
.env.*
*.env
secrets.yaml
secrets.json

# ── RAGStack runtime files ───────────────────────────────────────────────────
# Persisted document index — regenerated by /rag-index or GUI
ragstack-docs.json

# ── Graphify generated output ────────────────────────────────────────────────
# SHA256 extraction cache — regenerated automatically, not useful to share
graphify-out/cache/

# mtime-based index, always invalid after git clone
graphify-out/manifest.json

# Local token-cost tracking — not useful to share
graphify-out/cost.json

# Chunk staging files
graphify-out/.graphify_chunk_*.json

# Keep the actual knowledge graph and reports (useful for teams)
# !graphify-out/graph.json       ← committed — teammates get the graph immediately
# !graphify-out/GRAPH_REPORT.md  ← committed — Claude reads this automatically
# !graphify-out/graph.html       ← committed — interactive visualization

