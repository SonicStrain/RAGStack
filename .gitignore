Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo
*~

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

